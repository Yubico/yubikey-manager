<?xml version="1.0"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi" xmlns:util="http://schemas.microsoft.com/wix/UtilExtension">
  <?define ProductVersion="{RELEASE_VERSION}" ?>
  <?define ProductName="YubiKey Manager CLI" ?>
  <?define BinaryDir="{BINARY_DIR}" ?>

   <Product Id="*" UpgradeCode="fba0ab59-48d1-4050-82eb-acad31cf2239" Name="$(var.ProductName)" Version="$(var.ProductVersion)" Manufacturer="Yubico AB" Language="1033">
      <Package InstallerVersion="{INSTALLER_VERSION}" Compressed="yes" InstallScope="perMachine" Platform="{ARCHITECTURE}" Description="$(var.ProductName) $(var.ProductVersion)" />
      <Media Id="1" Cabinet="ykman.cab" EmbedCab="yes"/>

      <WixVariable Id="WixUIDialogBmp" Value="yubico-msi-background.png" />
      <WixVariable Id="WixUIBannerBmp" Value="yubico-msi-y-banner.png" />

      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLDIR" />
      <Property Id="YKMANSERVICEARCH">
        <RegistrySearch Id="ServiceArchitecture" Root="HKLM" Key="Software\Yubico\YubiKey Manager Service" Name="Architecture" Type="raw" Win64="yes" />
      </Property>
      <Condition Message="The installed YubiKey Manager Service has a different architecture. Use installers of the same architecture for YubiKey Manager and Yubico Authenticator.">
        Installed OR NOT YKMANSERVICEARCH OR YKMANSERVICEARCH = "{ARCHITECTURE}"
      </Condition>

      <Property Id="PREVIOUSVERSIONSINSTALLED" Secure="yes" />

      <Upgrade Id="fba0ab59-48d1-4050-82eb-acad31cf2239">
      	<UpgradeVersion
              Minimum="1.0.0.0"
              Property="PREVIOUSVERSIONSINSTALLED"
              IncludeMinimum="yes" IncludeMaximum="no" />
      </Upgrade>

	  <InstallExecuteSequence>
	    <RemoveExistingProducts Before="InstallInitialize" />
	  </InstallExecuteSequence>

      <UI>
          <UIRef Id="WixUI_InstallDir" />
          <Publish Dialog="WelcomeDlg"
            Control="Next"
            Event="NewDialog"
            Value="InstallDirDlg"
            Order="2">1</Publish>
          <Publish Dialog="InstallDirDlg"
            Control="Back"
            Event="NewDialog"
            Value="WelcomeDlg"
            Order="2">1</Publish>
      </UI>

      <Directory Id="TARGETDIR" Name="SourceDir">
         <Directory Id="ProgramFiles64Folder" Name="PFiles">
            <Directory Id="YubicoDir" Name="Yubico">
                <Directory Id="INSTALLDIR" Name="YubiKey Manager CLI">
                </Directory>
            </Directory>
         </Directory>
         <Directory Id="ProgramMenuFolder">
         	<Directory Id="ApplicationProgramsFolder" Name="YubiKey Manager CLI"/>
         </Directory>

         <Component Id='EnvVars' Guid="{ENVVARS_GUID}">
           <Environment Id='PathEnvVar' Action='set' System='yes' Name='PATH' Part='last' Value='[INSTALLDIR]'/>
         </Component>
      </Directory>

      <DirectoryRef Id="INSTALLDIR">
         <Component Id="YkmanExe" Guid="{YKMAN_EXE_GUID}">
             <File Id="ykman.exe" Source="$(var.BinaryDir)\ykman.exe" KeyPath="yes" />
         </Component>
      </DirectoryRef>

      <DirectoryRef Id="TARGETDIR">
        <Merge Id="YkmanService" SourceFile="$(var.ServiceModule)" DiskId="1" Language="1033" />
      </DirectoryRef>
      <DirectoryRef Id="ApplicationProgramsFolder">
         <Component Id="ApplicationShortcut" Guid="{SHORTCUT_GUID}">
             <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall"/>
             <RegistryValue Root="HKCU" Key="Software\Yubico\YubiKey Manager CLI" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
             <util:RemoveFolderEx Id="Remove" On="install" Property="INSTALLDIR" />
         </Component>

      </DirectoryRef>

      <Feature Id="DefaultFeature" Level="1">
         <ComponentRef Id="YkmanExe" />
         <MergeRef Id="YkmanService" />
      </Feature>

      <Feature Id="MainApplication" Title="Main Application" Level="1">
      	<ComponentRef Id="ApplicationShortcut" />
      </Feature>

      <Feature Id="ModifyPath" Title="Modify Path" Level="1">
        <ComponentRef Id="EnvVars" />
      </Feature>

   </Product>
</Wix>
